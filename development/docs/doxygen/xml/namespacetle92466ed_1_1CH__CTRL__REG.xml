      <memberdef kind="function" id="namespacetle92466ed_1_1CH__CTRL__REG_1a1fabb0a56db218aa86e55a2019675ed6" prot="public" static="no" constexpr="yes" const="no" explicit="no" inline="no" noexcept="yes" virt="non-virtual">
