      <memberdef kind="function" id="uniontle92466ed_1_1SPIFrame_1ae5c5a3b7ad3cc6083b4168f1035ceb1a" prot="public" static="yes" constexpr="yes" const="no" explicit="no" inline="yes" noexcept="yes" virt="non-virtual">
