# =============================================================================
# ESP32-S3 specific defaults — switch console to the native USB-Serial-JTAG
# bridge (303a:1001) so the example boots cleanly on USB-only dev boards.
#
# The ESP32-S3's UART0 default pins (GPIO43/44) are usually NOT routed to
# the host on USB-JTAG-only boards, so writing to them via newlib stdout
# produces garbage at best and a `LoadProhibited` in the FreeRTOS console
# mutex path at worst. Pinning the primary console to USB-Serial-JTAG
# avoids both.
# =============================================================================

# Primary console = USB-Serial-JTAG (the device that enumerates as
# /dev/ttyACM0 on Linux). UART0 stays disabled as primary.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
# CONFIG_ESP_CONSOLE_UART_DEFAULT is not set
# CONFIG_ESP_CONSOLE_UART_CUSTOM is not set
# CONFIG_ESP_CONSOLE_NONE is not set

# Disable the secondary console — we don't need a fallback UART, and
# leaving it on creates two stdout sinks that can race for the lock.
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
# CONFIG_ESP_CONSOLE_SECONDARY_USB_SERIAL_JTAG is not set

# Resilient shutdown: keep flushing logs to USB-JTAG even if the host
# isn't listening (otherwise newlib's printf can block forever waiting
# for the host to drain the FIFO).
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG_PRINTF_NONBLOCKING=y
